<Project>

    <PropertyGroup>
        <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    </PropertyGroup>

    <ItemGroup Label="Mercurio">
        <PackageVersion Include="CommunityToolkit.HighPerformance" Version="8.4.2" />
        <PackageVersion Include="Microsoft.AspNetCore.Hosting.Abstractions" Version="2.3.14" />
        <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.15" />
        <PackageVersion Include="Polly" Version="8.9.1" />
        <PackageVersion Include="RabbitMQ.Client" Version="7.2.2" />
        <PackageVersion Include="System.Reactive" Version="6.1.0" />
        <PackageVersion Include="System.Text.Json" Version="10.0.15" />
    </ItemGroup>

    <ItemGroup Label="Mercurio.Hosting">
        <PackageVersion Include="Microsoft.Extensions.Diagnostics.HealthChecks.Abstractions" Version="10.0.15" />
        <PackageVersion Include="Microsoft.Extensions.Hosting" Version="10.0.15" />
    </ItemGroup>

    <ItemGroup Label="Build">
        <PackageVersion Include="Microsoft.Sbom.Targets" Version="4.1.13" />
    </ItemGroup>

    <ItemGroup Label="Tests">
        <PackageVersion Include="coverlet.collector" Version="10.1.1" />
        <PackageVersion Include="coverlet.msbuild" Version="10.1.1" />
        <PackageVersion Include="Microsoft.Extensions.Configuration" Version="10.0.15" />
        <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="10.0.15" />
        <PackageVersion Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.15" />
        <PackageVersion Include="Microsoft.Extensions.Logging.Console" Version="10.0.15" />
        <PackageVersion Include="Microsoft.Extensions.Options.DataAnnotations" Version="10.0.15" />
        <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.12.0" />
        <PackageVersion Include="Moq" Version="4.21.0" />
        <PackageVersion Include="NUnit" Version="5.0.0" />
        <PackageVersion Include="NUnit.Analyzers" Version="4.15.0" />
        <PackageVersion Include="NUnit3TestAdapter" Version="6.3.1" />
        <PackageVersion Include="OpenTelemetry" Version="1.21.0" />
        <PackageVersion Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.21.0" />
        <PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="1.21.0" />
        <PackageVersion Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.21.0" />
        <PackageVersion Include="OpenTelemetry.Instrumentation.Http" Version="1.21.0" />
        <PackageVersion Include="OpenTelemetry.Instrumentation.Runtime" Version="1.21.0" />
        <PackageVersion Include="Testcontainers.RabbitMq" Version="4.16.0" />
    </ItemGroup>

</Project>
